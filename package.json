{
  "name": "dsh-screen-helper",
  "version": "0.1.32",
  "description": "Screen Automation Helper bundle for DeepSeek Harness: a screen_automation tool that drives the ScreenAutomationHelper CLI (screen capture, OCR, mouse, keyboard, clipboard, UI tree, workflow orchestration) with a read/write risk tier and per-call user approval for screen-mutating actions.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "screen-automation",
    "ocr",
    "gui-automation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-helpers.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/classify.test.mjs test/e2e.test.mjs test/plugin.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify:roundtrip": "npm run build && node scripts/roundtrip.mjs",
    "verify:approval": "npm run build && node scripts/approval-gate.mjs",
    "verify:always": "npm run build && node scripts/always-mode.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.7.0"
  }
}
